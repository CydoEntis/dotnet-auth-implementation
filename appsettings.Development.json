{
  "Application": {
    "Name": "your-project-name"
  },
  "ConnectionStrings": {
    "DefaultConnection": "your-db-connection-string"
  },
  "Cors": {
    "AllowedOrigins": [
      "your-origin"
    ],
    "ExposedHeaders": [
      "Cross-Origin-Opener-Policy",
      "Cross-Origin-Embedder-Policy"
    ]
  },
  "Jwt": {
    "Secret": "your-secret",
    "Issuer": "your-issuer",
    "Audience": "your-aduience",
    "AccessTokenExpirationInHours": 1,
    "RefreshTokenExpirationInHours": 16,
    "Algorithm": "HS256",
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true
  },
  "Email": {
    "SmtpServer": "your-smtp-server",
    "SmtpPort": 587,
    "SmtpUsername": "your-smpt-username",
    "SmtpPassword": "your-smpt-password",
    "FromEmail": "noreply@yourapp.com",
    "SendGrid": {
      "ApiKey": "your-sendgrid-api-key"
    }
  },
  "Auth": {
    "Google": {
      "ClientId": "your-google-client-id",
      "ClientSecret": "your-google-client-secret",
      "CallbackPath": "your-call-back-path",
      "RedirectUri": "your-redirect-uri"
    }
  }
}